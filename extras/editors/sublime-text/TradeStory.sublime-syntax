%YAML 1.2
---
#  Trade Story syntax and error highlighting for Sublime Text.
#
#  To install, see README.md in this folder.

name: Trade Story
file_extensions:
  - trade
scope: source.trade

contexts:
  main:
    - include: common_checks
    - match: '(?i)^[ ]{0,10}(Story)\b'
      captures: {1: keyword.language.trade}
      set: [phase_post_story, story_title]
    - include: invalid_fallthrough

  # -------------------------------------------------------------------------
  # Phase 1: Header Phase
  # -------------------------------------------------------------------------
  phase_post_story:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_setup
    - match: '(?i)^[ ]{0,10}(Trading)\b'
      captures: {1: keyword.language.trade}
      set: [phase_post_trading, predicate_body]
    - match: '(?i)^[ ]{0,10}(Sources?)\b'
      captures: {1: keyword.language.trade}
      set: [phase_source_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_post_trading:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_setup
    - match: '(?i)^[ ]{0,10}(Sources?)\b'
      captures: {1: keyword.language.trade}
      set: [phase_source_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Trading)\b'
      captures: {1: invalid.illegal.split-stack.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_source_stack:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_setup
    - match: '(?i)^[ ]{0,10}(Sources?|And)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Trading)\b'
      captures: {1: keyword.language.trade}
      set: [phase_post_trading_from_source, predicate_body]
    - include: invalid_fallthrough

  phase_post_trading_from_source:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_setup
    - match: '(?i)^[ ]{0,10}(Trading|Sources?|And)\b'
      captures: {1: invalid.illegal.split-stack.trade}
      push: predicate_body
    - include: invalid_fallthrough

  # -------------------------------------------------------------------------
  # Phase 2: Trade Setup
  # -------------------------------------------------------------------------
  # Given opens the Trade Setup keywords; anything else arriving first is
  # out of order.
  jump_setup:
    - match: '(?i)^[ ]{0,10}(Given)\b'
      captures: {1: keyword.language.trade}
      set: [phase_given_stack, predicate_body]

  phase_given_stack:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(Given|And)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Except)\b'
      captures: {1: keyword.language.trade}
      set: [phase_except_post_given, predicate_body]
    - match: '(?i)^[ ]{0,10}(When)\b'
      captures: {1: keyword.language.trade}
      set: [phase_when_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Then)\b'
      captures: {1: keyword.language.trade}
      set: [phase_then_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Or except)\b'
      captures: {1: invalid.illegal.missing-except.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_except_post_given:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(Except|Or except)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(When)\b'
      captures: {1: keyword.language.trade}
      set: [phase_when_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Then)\b'
      captures: {1: keyword.language.trade}
      set: [phase_then_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Given)\b'
      captures: {1: invalid.illegal.split-stack.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_when_stack:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(When|And)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Except)\b'
      captures: {1: keyword.language.trade}
      set: [phase_except_post_when, predicate_body]
    - match: '(?i)^[ ]{0,10}(Then)\b'
      captures: {1: keyword.language.trade}
      set: [phase_then_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Or except)\b'
      captures: {1: invalid.illegal.missing-except.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_except_post_when:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(Except|Or except)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Then)\b'
      captures: {1: keyword.language.trade}
      set: [phase_then_stack, predicate_body]
    - match: '(?i)^[ ]{0,10}(Given|When)\b'
      captures: {1: invalid.illegal.split-stack.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_then_stack:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_with
    - match: '(?i)^[ ]{0,10}(Then|And)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Except)\b'
      captures: {1: keyword.language.trade}
      set: [phase_except_post_then, predicate_body]
    - match: '(?i)^[ ]{0,10}(Or except)\b'
      captures: {1: invalid.illegal.missing-except.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_except_post_then:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_with
    - match: '(?i)^[ ]{0,10}(Except|Or except)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Given|When|Then)\b'
      captures: {1: invalid.illegal.split-stack.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  # -------------------------------------------------------------------------
  # Phase 3: With
  # -------------------------------------------------------------------------
  jump_with:
    - match: '(?i)^[ ]{0,10}(With)\b'
      captures: {1: keyword.language.trade}
      set: [phase_with, predicate_body]

  phase_with:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - include: jump_mgmt
    - match: '(?i)^[ ]{0,10}(With)\b'
      captures: {1: invalid.illegal.split-stack.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  # -------------------------------------------------------------------------
  # Phase 4: Trade Management
  # -------------------------------------------------------------------------
  jump_mgmt:
    - match: '(?i)(?=^[ ]{0,10}(SL|Until|Or until|Taking|Unless|Or unless)\b)'
      set: phase_mgmt_00

  phase_mgmt_00:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(SL)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Until)\b'
      captures: {1: keyword.language.trade}
      set: [phase_mgmt_U0, expect_taking, predicate_body]
    - match: '(?i)^[ ]{0,10}(Unless)\b'
      captures: {1: keyword.language.trade}
      set: [phase_mgmt_0L, predicate_body]
    - match: '(?i)^[ ]{0,10}(Or until|Or unless|Taking)\b'
      captures: {1: invalid.illegal.missing-pair.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_mgmt_U0:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(SL)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Until|Or until)\b'
      captures: {1: keyword.language.trade}
      push: [expect_taking, predicate_body]
    - match: '(?i)^[ ]{0,10}(Unless)\b'
      captures: {1: keyword.language.trade}
      set: [phase_mgmt_UL, predicate_body]
    - match: '(?i)^[ ]{0,10}(Taking)\b'
      captures: {1: invalid.illegal.orphaned-taking.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Or unless)\b'
      captures: {1: invalid.illegal.missing-pair.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_mgmt_0L:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(SL|Unless|Or unless)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Until)\b'
      captures: {1: keyword.language.trade}
      set: [phase_mgmt_UL, expect_taking, predicate_body]
    - match: '(?i)^[ ]{0,10}(Or until|Taking)\b'
      captures: {1: invalid.illegal.missing-pair.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  phase_mgmt_UL:
    - include: common_checks
    - include: jump_notes
    - include: jump_reversed
    - match: '(?i)^[ ]{0,10}(SL|Unless|Or unless)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(Until|Or until)\b'
      captures: {1: keyword.language.trade}
      push: [expect_taking, predicate_body]
    - match: '(?i)^[ ]{0,10}(Taking)\b'
      captures: {1: invalid.illegal.orphaned-taking.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}(And)\b'
      captures: {1: invalid.illegal.orphaned-and.trade}
      push: predicate_body
    - include: invalid_fallthrough

  expect_taking:
    - include: common_checks
    - match: '(?i)^[ ]{0,10}(Taking)\b'
      captures: {1: keyword.language.trade}
      set: predicate_body
    - match: '(?i)^[ ]{0,10}(Notes:?)(?=\s|$)'
      captures: {1: invalid.illegal.missing-taking.trade}
      set: phase_notes_start
    - match: '(?i)^[ ]{0,10}((?:Reversed|Reversal):?)(?=\s|$)'
      captures: {1: invalid.illegal.missing-taking.trade}
      set: phase_reversed
    - match: '(?i)^[ ]{0,10}(Story|Trading|Sources?|Given|When|Then|With|Except|Or except|And|Until|Or until|SL|Unless|Or unless)\b'
      captures: {1: invalid.illegal.missing-taking.trade}
      set: predicate_body
    - match: '^[ ]{0,10}\S.*'
      scope: invalid.illegal.missing-taking.trade

  # -------------------------------------------------------------------------
  # Phase 5: Reversed
  # -------------------------------------------------------------------------
  # Reversed is alone on its line; text after it is flagged. The clauses under
  # it may be any keyword, in a story's order, so the section is highlighted
  # permissively rather than re-run through the phases above.
  jump_reversed:
    - match: '(?i)^[ ]{0,10}((?:Reversed|Reversal):?)[ ]*$'
      captures: {1: keyword.language.trade}
      set: phase_reversed
    - match: '(?i)^[ ]{0,10}((?:Reversed|Reversal):?)[ ]+(\S.*)$'
      captures: {1: keyword.language.trade, 2: invalid.illegal.reversed-text.trade}
      set: phase_reversed

  phase_reversed:
    - include: common_checks
    - include: jump_notes
    - match: '(?i)^[ ]{0,10}(Story|Trading|Sources?|Given|When|Then|With|Except|Or except|And|Until|Or until|Taking|SL|Unless|Or unless)\b'
      captures: {1: keyword.language.trade}
      push: predicate_body
    - match: '(?i)^[ ]{0,10}((?:Reversed|Reversal):?)(?=\s|$)'
      captures: {1: invalid.illegal.out-of-order.trade}
    - include: invalid_fallthrough

  # -------------------------------------------------------------------------
  # Phase 6: Notes & Predicates
  # -------------------------------------------------------------------------
  jump_notes:
    - match: '(?i)(?=^[ ]{0,10}(Notes:?)(?=\s|$))'
      set: phase_notes_start

  phase_notes_start:
    - match: '(?i)^[ ]{0,10}(Notes:?)(?=\s|$)'
      captures: {1: keyword.language.notes.trade}
      set: notes_block

  notes_block:
    - match: '.*'
      scope: comment.block.trade

  # The rest of the keyword line is predicate text, with reversible tokens
  # picked out of it.
  predicate_body:
    - meta_scope: string.unquoted.trade
    - include: reversible_token
    - match: '$'
      set: continuation_block

  # The Story predicate is the story's name, scoped so Goto Symbol lists it.
  story_title:
    - meta_scope: entity.name.section.trade
    - include: reversible_token
    - match: '$'
      set: continuation_block

  continuation_block:
    - include: common_checks
    # Valid continuation: 11 or more spaces. Scopes string and stays in loop.
    - match: '^(?=[ ]{11,})'
      push: continuation_line
    # Invalid continuation or next line: 0-10 spaces. Pops back to the phase.
    - match: '^(?=[ ]{0,10}\S)'
      pop: true

  continuation_line:
    - meta_scope: string.unquoted.trade
    - include: reversible_token
    - match: '$'
      pop: true

  reversible_token:
    - match: '(?i)\[(?:buy|sell|above|below)\]'
      scope: keyword.operator.reversible.trade

  # -------------------------------------------------------------------------
  # Validation Catch-Alls & Formatting
  # -------------------------------------------------------------------------
  invalid_fallthrough:
    - match: '(?i)^[ ]{0,10}(Story|Trading|Sources?|Given|When|Then|With|Except|Or except|Until|Or until|Taking|SL|Unless|Or unless|And|Reversed|Reversal)\b'
      captures: {1: invalid.illegal.out-of-order.trade}
      push: predicate_body
    - match: '^[ ]{0,10}\S.*'
      scope: invalid.illegal.unrecognized-text.trade

  common_checks:
    - match: '^[ ]*#.*'
      scope: comment.line.number-sign.trade
    - match: '^[ ]*[\t\x{00A0}\x{2000}-\x{200B}].*'
      scope: invalid.illegal.whitespace.trade
    - match: '^[ ]*$'
      scope: text.trade